# Database Configuration
# Set DB_TYPE to 'mysql' for production or 'sqlite' for development/testing
# If DB_TYPE is not set or MySQL connection fails, SQLite will be used as fallback

# Database Type: mysql or sqlite
DB_TYPE=sqlite

# MySQL Configuration (required when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bdta
DB_USER=root
DB_PASSWORD=

# SQLite Configuration (used when DB_TYPE=sqlite or as fallback)
# SQLite database file path (relative to backend directory)
SQLITE_DB_PATH=bdta.db
