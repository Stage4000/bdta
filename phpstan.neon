includes:
  - phpstan-baseline.neon

parameters:
  level: 10
  paths:
    - backend
    - portal
    - client
    - blog
    - index.php
    - page.php
    - test_integration.php
    - test_crud.php
    - test_database.php
    - test_packages.php
    - test_portal_credit_booking.php
    - test_unified_credits.php
  excludePaths:
    # Exclude vendored/archived assets not part of the core PHP analysis surface
    - backend/includes/phpmailer
    - brooksdogtrainingacademy.com_project.sitebuilder # static sitebuilder export
    - backup.sitebuilder
